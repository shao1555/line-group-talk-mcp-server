{
	"name": "line-group-talk-mcp-server",
	"main": "src/index.ts",
	"rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
	"workers_dev": true,
	"routes": [{ "pattern": "line-talk.example.com", "custom_domain": true }],
	"account_id": "00000000000000000000000000000000",
	// Latest date supported by the workerd bundled with the pinned toolchain.
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"PORTAL_ORIGIN": "https://line-talk.example.com",
		"LEGACY_PORTAL_ORIGIN": "https://legacy.example.com",
		"LINE_LOGIN_CHANNEL_ID": "0000000000",
		"MAX_ATTACHMENT_BYTES": "104857600",
		"AI_MONTHLY_BUDGET_USD": "5",
		"AI_DAILY_IMAGES": "20",
		"AI_DAILY_AUDIO_SECONDS": "3600",
		"AI_DAILY_EMBEDDING_BYTES": "500000",
		"AI_DAILY_ANSWERS": "100",
		"AI_MAX_AUDIO_SECONDS": "600"
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "KNOWLEDGE",
			"index_name": "line-group-talk-knowledge"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "line-group-talk-attachments"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "ATTACHMENT_QUEUE",
				"queue": "line-group-talk-attachments"
			},
			{
				"binding": "KNOWLEDGE_QUEUE",
				"queue": "line-group-talk-knowledge"
			}
		],
		"consumers": [
			{
				"queue": "line-group-talk-attachments",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_concurrency": 1,
				"max_retries": 5,
				"dead_letter_queue": "line-group-talk-attachments-dlq"
			},
			{
				"queue": "line-group-talk-knowledge",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_concurrency": 5,
				"max_retries": 2,
				"dead_letter_queue": "line-group-talk-knowledge-dlq"
			}
		]
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "line-group-talk",
			"database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "00000000000000000000000000000000"
		}
	]
}
